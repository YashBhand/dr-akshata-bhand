generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum UserRole {
  ADMIN
  STAFF
  PET_OWNER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  phone         String?
  role          UserRole  @default(PET_OWNER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  pets          Pet[]
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Pet {
  id             String          @id @default(cuid())
  name           String
  species        String
  breed          String?
  birthDate      DateTime?
  weight         Float?
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaccinations   Vaccination[]
  healthRecords  HealthRecord[]
  reminders      Reminder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Vaccination {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  nextDue     DateTime?
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model HealthRecord {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String?
  notes     String?
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Reminder {
  id        String   @id @default(cuid())
  type      String
  message   String
  dueDate   DateTime
  sent      Boolean  @default(false)
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Booking {
  id          String        @id @default(cuid())
  ownerName   String
  phone       String
  email       String?
  animalType  String
  breed       String?
  age         String?
  weight      String?
  complaint   String
  preferredAt DateTime
  fileUrl     String?
  status      BookingStatus @default(PENDING)
  paymentId   String?
  qrCode      String?
  amount      Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  slug      String
  locale    String
  title     String
  excerpt   String
  category  String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
}

model Testimonial {
  id       String  @id @default(cuid())
  name     String
  pet      String?
  quoteEn  String
  quoteMr  String
  rating   Int     @default(5)
  imageUrl String?
}

model GalleryItem {
  id       String @id @default(cuid())
  titleEn  String
  titleMr  String
  imageUrl String
  category String
  order    Int    @default(0)
}

model FAQ {
  id       String @id @default(cuid())
  questionEn String
  questionMr String
  answerEn   String
  answerMr   String
  order      Int    @default(0)
}

model PrescriptionRequest {
  id        String   @id @default(cuid())
  userId    String
  petName   String
  medicine  String
  notes     String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model BlogQuestion {
  id        String   @id @default(cuid())
  name      String
  email     String
  question  String
  locale    String   @default("en")
  answered  Boolean  @default(false)
  createdAt DateTime @default(now())
}
